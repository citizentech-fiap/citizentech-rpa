# Copie para .env e preencha. O .env NUNCA vai para o repositório.
# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: envio real de e-mail (por padrão o robô só gera rascunhos .eml em outbox/)
# Host, porta, STARTTLS e remetente ficam em config.yaml.
# Ambos vazios permitem servidor local de testes sem autenticação.
SMTP_USER=
SMTP_PASSWORD=
